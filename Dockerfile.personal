# LiteLLM 个人版 Docker 镜像（Debian glibc，兼容服务器编译的 Rust 二进制）
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/* && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

COPY litellm-rust/litellm-chat-gateway /app/litellm-chat-gateway
COPY ui/litellm-dashboard/out /app/static

WORKDIR /app
ENV STATIC_DIR=/app/static
ENV HOST=0.0.0.0
ENV PORT=4001

EXPOSE 4001
CMD ["/app/litellm-chat-gateway"]
