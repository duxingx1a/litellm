# LiteLLM 个人版 Docker 镜像
# 前端在 Windows 上预构建，Docker 只打包 Alpine + Rust 二进制 + 前端静态文件
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

COPY litellm-rust/litellm-chat-gateway /app/litellm-chat-gateway
COPY ui/litellm-dashboard/out /app/static

WORKDIR /app
ENV STATIC_DIR=/app/static
ENV HOST=0.0.0.0
ENV PORT=4001

EXPOSE 4001
CMD ["/app/litellm-chat-gateway"]
